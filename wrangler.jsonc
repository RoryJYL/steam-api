/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (set via: wrangler secret put <NAME>):
 * - STEAM_API_KEY: Steam Web API key, free from https://steamcommunity.com/dev/apikey
 *
 * vars:
 * - STEAM_ID64: the 17-digit SteamID64 of the profile to track
 *   (found in Steam client -> Account details)
 *
 * KV namespace: create with `wrangler kv namespace create STEAM_CACHE`
 * and paste the id below.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-03",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CACHE_TTL_SECONDS": "43200",
    "ALLOWED_DOMAINS": "rorytech.com",
    "STEAM_ID64": "76561198215402772"
  },
  // 部署前把 id 替换为 `pnpm wrangler kv namespace create STEAM_CACHE` 返回的真实 id
  // 本地 dev 时 Miniflare 会模拟该命名空间，占位 id 不会真的被访问
  "kv_namespaces": [
    {
      "binding": "STEAM_CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
